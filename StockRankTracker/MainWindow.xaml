<Window x:Class="StockRankTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockRankTracker.Views"
        Title="StockRankTracker" Width="750" Height="800"
        MinWidth="650" MinHeight="600"
        Background="#1a1a2e"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl Background="#1a1a2e" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="TabControl_SelectionChanged">

            <TabControl.Resources>
                <!-- Tab 標籤樣式 -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#888"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Padding" Value="20,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" Cursor="Hand">
                                    <TextBlock x:Name="TabText" Text="{TemplateBinding Header}"
                                               Foreground="#888" FontSize="15" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabText" Property="Foreground" Value="#4FC3F7"/>
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4FC3F7"/>
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabText" Property="Foreground" Value="#aaa"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 盤中 -->
            <TabItem Header="盤中">
                <views:IntradayView x:Name="IntradayTab"/>
            </TabItem>

            <!-- 盤後 -->
            <TabItem Header="盤後">
                <views:AfterMarketView x:Name="AfterMarketTab"/>
            </TabItem>

            <!-- 設定 -->
            <TabItem Header="設定">
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
