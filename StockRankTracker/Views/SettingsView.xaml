<UserControl x:Class="StockRankTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StockRankTracker.Converters"
             Background="#1a1a2e">

    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <Style x:Key="TimeInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#3a3a5a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxLength" Value="5"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="70"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ===== 自動抓取時間 ===== -->
            <Border Background="#22223a" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="自動抓取時間" Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="系統固定時間" Foreground="#888" FontSize="12" Margin="0,0,0,5"/>
                    <Border Background="#1a1a2e" CornerRadius="4" Padding="12,8" Margin="0,0,0,15">
                        <TextBlock Text="{Binding SystemTimes}" Foreground="#4FC3F7" FontSize="14"/>
                    </Border>

                    <TextBlock Text="自訂時間（09:00 ~ 13:30）" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="時間 1" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CustomTime1, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="時間 2" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CustomTime2, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="時間 3" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CustomTime3, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="時間 4" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CustomTime4, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="時間 5" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CustomTime5, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}"/>
                    </StackPanel>

                    <Button Content="儲存設定" Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource FetchButtonStyle}"
                            HorizontalAlignment="Left" Padding="20,8"/>
                </StackPanel>
            </Border>

            <!-- ===== 歷史資料匯入 ===== -->
            <Border Background="#22223a" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="歷史資料匯入" Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="匯入 XQ 匯出的 CSV 檔案，可一次選擇多個檔案"
                               Foreground="#888" FontSize="12" Margin="0,0,0,10"/>

                    <!-- 匯入按鈕 -->
                    <Button Content="選擇 CSV 檔案匯入" Command="{Binding ImportCsvCommand}"
                            Style="{StaticResource FetchButtonStyle}"
                            HorizontalAlignment="Left" Padding="20,8"/>

                    <!-- 匯入結果 -->
                    <TextBlock Text="{Binding ImportResult}"
                               Foreground="#ccc" FontSize="12" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>

                    <!-- 資料完整度 -->
                    <TextBlock Text="收盤資料完整度（最近20個交易日）"
                               Foreground="#888" FontSize="12" Margin="0,15,0,8"/>

                    <ItemsControl ItemsSource="{Binding DataDateList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding DateDisplay}" Foreground="#aaa" FontSize="12" Width="110"/>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                                               FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 資料庫管理 ===== -->
            <Border Background="#22223a" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="資料庫管理" Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="目前容量" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding DatabaseSizeDisplay}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="警示門檻" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding WarningSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TimeInputStyle}" Width="60"/>
                        <TextBlock Text=" MB" Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="清除30天以前的收盤資料" Command="{Binding CleanOldDataCommand}"
                            HorizontalAlignment="Left" Padding="20,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#8B0000" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#B22222"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="保留最近30天，其餘刪除" Foreground="#666" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 狀態訊息 ===== -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                       FontSize="13" Margin="0,5,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
